{
  "name": "doop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "npm": "^12.2.0"
  },
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "typecheck": "ngc --noEmit -p tsconfig.app.json && tsc -p tsconfig.spec.json && tsc -p tsconfig.e2e.json",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
